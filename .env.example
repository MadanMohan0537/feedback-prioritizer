# Local collection database and a private, stable salt for pseudonymous IDs.
PULSE_DATABASE=data/pulse.db
PULSE_HASH_SALT=replace-with-a-long-random-secret

# Typeform
TYPEFORM_FORM_ID=
TYPEFORM_TOKEN=

# Zendesk
ZENDESK_SUBDOMAIN=
ZENDESK_TOKEN=

# Intercom
INTERCOM_TOKEN=

# Apple App Store Connect (supply a short-lived signed JWT)
APPLE_APP_ID=
APPLE_CONNECT_TOKEN=

# Google Play Android Publisher API (supply an OAuth access token)
GOOGLE_PLAY_PACKAGE=
GOOGLE_PLAY_ACCESS_TOKEN=

# Generic JSON API
PULSE_API_TOKEN=

# Legacy dashboard adapters (optional)
FEEDBACK_GITHUB_URL=
FEEDBACK_GITHUB_TOKEN=
FEEDBACK_SLACK_URL=
FEEDBACK_SLACK_TOKEN=
FEEDBACK_INTERCOM_URL=
FEEDBACK_INTERCOM_TOKEN=
FEEDBACK_APP_REVIEWS_URL=
FEEDBACK_APP_REVIEWS_TOKEN=
