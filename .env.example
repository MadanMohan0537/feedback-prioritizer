# Set only the sources you want to import. URLs must return JSON and tokens are
# read at runtime; never commit real credentials.

# GitHub Issues API example:
# FEEDBACK_GITHUB_URL=https://api.github.com/repos/OWNER/REPO/issues?state=all
FEEDBACK_GITHUB_TOKEN=

# Slack conversations.history-compatible endpoint or approved proxy:
FEEDBACK_SLACK_URL=
FEEDBACK_SLACK_TOKEN=

# Zendesk tickets endpoint:
FEEDBACK_ZENDESK_URL=
FEEDBACK_ZENDESK_TOKEN=

# Intercom conversations endpoint:
FEEDBACK_INTERCOM_URL=
FEEDBACK_INTERCOM_TOKEN=

# App Store / Google Play review JSON endpoint or approved export service:
FEEDBACK_APP_REVIEWS_URL=
FEEDBACK_APP_REVIEWS_TOKEN=

# Optional path for persistent topic governance and outcome records:
# FEEDBACK_TOPIC_REGISTRY=/absolute/path/to/topic_registry.json
